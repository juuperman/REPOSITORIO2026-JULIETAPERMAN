#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    char palabra [5];
    printf("Ingrese la contraseña: ");
    scanf("%s", palabra);
    if(strcmp(palabra, "hola")!=0){
        printf("Incorrecto, no vuelva por acá");
    } else {
        printf("Usted escribió: %s", palabra);
    }
    return 0;
}
