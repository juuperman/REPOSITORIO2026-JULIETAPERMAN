//2- Crear un código que una vez indicados los datos que almacena un vector, sume todos sus datos y los imprima. 
//2.a -Una vez realizado, calcule el promedio de esos datos. 
#include <stdio.h>
int vector[4];
int x, suma;
float promedio; 

int main()
{
    for(x=0; x<4; x++){
        printf("Indique el numero a guardar: ");
        scanf("%d", &vector[x]);
        suma += vector[x];
    }
    
    promedio = suma /4; 
    printf("La suma es: %d\n", suma);
    printf("El promedio es: %.2f\n", promedio); 
    return 0;
}

