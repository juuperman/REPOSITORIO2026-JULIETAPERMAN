//1- Crear un código en C que le permita al usuario modificar los datos de un vector y luego que el programa imprima los datos 1 por 1. 

#include <stdio.h>
int vector [5],x,n;
int main()
{
    for(x=0;x<5;x++){
        printf("Indique el numero a guardar: ");
        scanf("%d", &vector[x]);
    }
    for(n=0;n<5;n++){
        printf("\nEl numero ingresado es: %d",vector[n]);
    }
    return 0;
}
